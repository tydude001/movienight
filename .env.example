# ─── Movie Night — configuration ────────────────────────────────────
# Copy to .env and fill in the two secrets. Never commit the real .env.

# Plex --------------------------------------------------------------
# IMPORTANT: use the Plex host's LAN IP, NOT localhost. From inside the
# container "localhost" is the container itself.
PLEX_BASEURL=http://192.168.0.10:32400
# X-Plex-Token — see docs/deploy.md "Your Plex token".
PLEX_TOKEN=changeme
# Exact name of your Plex movie library section.
PLEX_MOVIE_LIBRARY=Movies

# TMDb --------------------------------------------------------------
# Free API key (v3 auth): https://www.themoviedb.org/settings/api
# Needed for Letterboxd matching + enrichment. (Plex sync works without it —
# tmdb ids come straight from Plex GUIDs — but with a key it also rescues
# movies whose Plex GUIDs only carry an IMDb id.)
TMDB_API_KEY=changeme
TMDB_MIN_INTERVAL=0.30

# Logging -----------------------------------------------------------
# LOG_FORMAT=json is one JSON object per line, for `docker logs` and anything
# reading it; `text` is the readable form for running the scripts by hand.
LOG_LEVEL=INFO
LOG_FORMAT=json

# App ---------------------------------------------------------------
# Your timezone: "Not tonight" hides a film until 6 a.m. here.
LOCAL_TZ=UTC
DATABASE_PATH=./data/watch.db
IMPORT_DIR=./data/imports
# Your two names, as the app shows them and as your export ZIPs are named
# (alex-*.zip, sam-*.zip). The first is blue, the second amber.
USER_A=alex
USER_B=sam

# Letterboxd usernames for automated sync (RSS nightly, watchlist weekly).
# Map to USER_A / USER_B above. Leave blank to skip a user.
LETTERBOXD_A=
LETTERBOXD_B=
# The watchlist sync reads your public watchlist pages, and Letterboxd's terms
# of use prohibit automated access, so it is OFF by default. Off, the watchlist
# comes from the export ZIP's watchlist.csv (drop a fresh export in
# data/imports). Set to 1 only if you've decided that's a trade you want to make.
LETTERBOXD_WATCHLIST_SCRAPE=0
# letterboxd-sync.sh passes this to `docker run --network` when set (e.g.
# `host`, or `container:<name>` to share another container's network).
# Blank = Docker's default bridge network.
SYNC_NETWORK=

# Notifications (optional) -------------------------------------------
# An ntfy topic URL (https://ntfy.sh/your-topic or self-hosted) OR a Discord
# webhook URL. The Plex sync pings it when a film lands on Plex that's on
# BOTH watchlists. Leave blank to disable.
NOTIFY_URL=

# External scores (optional) -----------------------------------------
# Shown on the film detail card (tap any poster). Everything here is
# optional — whatever is unavailable is simply left off the card.
#
# OMDb is the only practical source of a Rotten Tomatoes tomatometer:
# free key at https://www.omdbapi.com/apikey.aspx (1000 lookups/day).
# It also supplies the IMDb and Metacritic scores. Blank = skip all three.
OMDB_API_KEY=
# Letterboxd has no public API, so its average can only come from reading the
# public film page. Their terms of use prohibit automated access, so this is
# OFF by default and opt-in: set to 1 only if you've decided that's a trade you
# want to make. Unlike the sync jobs, it runs from the web container. See docs/deploy.md.
LETTERBOXD_SCORES=0
# How long a film's scores stay cached before a refetch. A week is plenty —
# these barely move, and the lookups are on demand.
RATINGS_TTL_HOURS=168

# Admin -------------------------------------------------------------
# HTTP Basic login for /admin and its buttons (Plex sync, import, enrich,
# resolve — every one writes the database or calls a third party). The browser
# prompts once on /admin. Either blank = the admin page answers 503, never open;
# set a long password here, or run scripts/set-admin-password.sh.
ADMIN_USER=admin
ADMIN_PASSWORD=
